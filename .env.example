# ========================================================
# CallOfDutyMobile — Environment Configuration
# ========================================================

# Supabase PostgreSQL Database (Transaction Pooler for Serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Database (For Prisma Migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Site URL for canonical links & OpenGraph (Set to your Vercel deployment URL or custom domain)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# Application Session Cryptographic Secret (min 32 random characters)
SESSION_SECRET="your-super-secret-random-jwt-encryption-key-min-32-chars"

# Initial Database Seed Admin Credentials
SEED_ADMIN_EMAIL="admin@mobileroster.in"
SEED_ADMIN_PASSWORD="YourSecureAdminPassword123!"

# Distributed Rate Limiting (Upstash Redis or Vercel KV)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Email Delivery (Gmail SMTP or Resend / SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="\"CallOfDutyMobile India\" <your-email@gmail.com>"
